import json
import os
import shutil
from datetime import datetime

class MatrixCalculator:
    def __init__(self):
        self.cache_file = "cache.json"
        self.cache = self.load_cache()

    def load_cache(self):
        if os.path.exists(self.cache_file):
            with open(self.cache_file, "r", encoding="utf-8") as file:
                return json.load(file)
        return {}

    def save_cache(self):
        with open(self.cache_file, "w", encoding="utf-8") as file:
            json.dump(self.cache, file, indent=4)

    def matrix_key(self, a, b):
        return json.dumps([a, b])

    def multiply(self, a, b):
        key = self.matrix_key(a, b)

        if key in self.cache:
            print("Результат получен из кэша")
            return self.cache[key]

        n = len(a)

        result = [[0 for _ in range(n)] for _ in range(n)]

        for i in range(n):
            for j in range(n):
                for k in range(n):
                    result[i][j] += a[i][k] * b[k][j]

        self.cache[key] = result
        self.save_cache()

        return result

    def backup_cache(self):
        if not os.path.exists("backups"):
            os.mkdir("backups")

        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

        backup_name = f"backups/cache_{timestamp}.json"

        shutil.copy(self.cache_file, backup_name)

        print("Резервная копия создана:")
        print(backup_name)

    def restore_cache(self, backup_file):
        shutil.copy(backup_file, self.cache_file)

        self.cache = self.load_cache()

        print("Кэш восстановлен")

def input_matrix(n):
    matrix = []

    print(f"\nВведите матрицу {n}x{n}")

    for i in range(n):
        row = list(map(int, input().split()))
        matrix.append(row)

    return matrix

def print_matrix(matrix):
    print("\nРезультат:")

    for row in matrix:
        print(*row)

def save_result(result, filename):
    with open(filename, "w", encoding="utf-8") as file:
        for row in result:
            file.write(" ".join(map(str, row)) + "\n")

def main():
    calc = MatrixCalculator()

    while True:
        print("\n===== МЕНЮ =====")
        print("1. Умножение матриц")
        print("2. Создать резервную копию")
        print("3. Восстановить кэш")
        print("4. Выход")

        choice = input("Выбор: ")

        if choice == "1":
            n = int(input("Размер матрицы N: "))

            print("Матрица A")
            a = input_matrix(n)

            print("Матрица B")
            b = input_matrix(n)

            result = calc.multiply(a, b)

            print_matrix(result)

            save = input("Сохранить результат в файл? (y/n): ")

            if save.lower() == "y":
                filename = input("Имя файла: ")
                save_result(result, filename)

        elif choice == "2":
            calc.backup_cache()

        elif choice == "3":
            backup_file = input(
                "Введите путь к резервной копии: "
            )
            calc.restore_cache(backup_file)

        elif choice == "4":
            break

        else:
            print("Неверный выбор")

if __name__ == "__main__":
    main()
```

